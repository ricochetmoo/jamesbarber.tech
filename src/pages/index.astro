---
import Layout from "../layouts/Layout.astro";
import ProjectsCarousel from "../components/ProjectsCarousel.astro";
import { Icon } from "astro-icon/components";
import "../styles/global.css";
import type { ImageMetadata } from "astro";

const logos = import.meta.glob<ImageMetadata>("../assets/projects/*/logo.svg", { eager: true, import: "default" });

const projects = [
	{
		title: "Schroll",
		logo: logos["../assets/projects/harker/logo.svg"],
		colour: "#38b7aa",
		slug: "schroll",
	},
	{
		title: "Harker",
		logo: logos["../assets/projects/harker/logo.svg"],
		colour: "#7413dc",
		slug: "harker",
	},
	{
		title: "Just Send",
		logo: logos["../assets/projects/harker/logo.svg"],
		colour: "#FF5D01",
		slug: "just-send",
	},
	{
		title: "Liverpool Lindr",
		logo: logos["../assets/projects/harker/logo.svg"],
		colour: "#000",
		slug: "liverpool-lindr",
	},
];
---

<Layout title="Home" description="All about James Barber.">
	<h1 class="font-heading">Astro!</h1>
	<p>Test</p>
	<h2 class="font-heading text-4xl mb-2">Projects</h2>
	<p>Here's a highlight of some of my more interesting projects.</p>
	<section class="relative left-1/2 w-screen -translate-x-1/2">
		<ProjectsCarousel projects={projects} />
	</section>
	<div class="flex items-center justify-end font-heading text-xl"><a href="/projects" class="flex items-center gap-2">All projects <Icon name="bi:arrow-right" class="inline-block w-6 h-6" /></a></div>
</Layout>
