---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
interface Props {
	projects: {
		title: string;
		logo: ImageMetadata;
		colour: string;
		slug: string;
		dark?: boolean;
	}[];
}

const {projects} = Astro.props;
---

<div class="flex gap-3 my-4 pl-3 overflow-x-scroll justify-center scrollbar-none">
	{
		projects.map((project) => (
			<a href={`/projects/${project.slug}`} class="flex-none">
				<div class="h-75 w-75 rounded-3xl relative" style={`background-color: ${project.colour}`}>
					<Image
						src={project.logo}
						alt={`${project.title} logo`}
						class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-5/6 object-contain"
					/>
					<Icon name="bi:arrow-right" class="absolute right-4 bottom-4 w-6 h-6 text-white" />
				</div>
				</a>
		))
	}
</div>