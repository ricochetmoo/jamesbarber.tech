---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<header class="flex items-center w-full border-b-2 border-gray-600 py-4 mb-4 flex-wrap gap-3">
	<span class="font-heading font-bold text-3xl sm:text-2xl">James Barber</span>
	<nav aria-label="Social links" class="ml-auto">
		<ul class="flex gap-1 text-xl items-center sm:gap-2">
			{
				[
					{
						icon: "simple-icons:github",
						name: "GitHub",
						href: "https://github.com/ricochetmoo",
					},
					{
						icon: "simple-icons:linkedin",
						name: "LinkedIn",
						href: "https://linkedin.com/in/jamesrorybarber",
					},
					{
						icon: "simple-icons:x",
						name: "X",
						href: "https://x.com/jamesrorybarber",
					},
				].map(({ icon, name, href }) => (
					<li>
						<a
							href={href}
							target="_blank"
							rel="noopener noreferrer"
							class="hover:text-gray-700 hover:scale-110 focus-visible:scale-110 transition-[color,transform] duration-300 ease-out motion-reduce:transition-none focus-visible:ring-offset-2 focus-visible:ring-2 focus-visible:ring-gray-900 focus-visible:outline-none size-8 inline-flex items-center justify-center"
							aria-label={name}
						>
							<Icon name={icon} desc={name} class="size-5 shrink-0" aria-hidden="true" />
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>